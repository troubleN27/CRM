# Скопируйте в mcp-server/.env и заполните. Файл .env не попадает в Git.

# Секретный ключ для входа в MCP-сервер (не короче 24 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Тот же ключ нужен агенту: переменная окружения OFFICE_MCP_KEY (см. .mcp.json в корне проекта).
MCP_SECRET_KEY=""

# Адрес сайта Офис-CRM и ключ агента для него (AGENT_API_KEY из .env сайта)
APP_URL="http://localhost:3000"
APP_AGENT_KEY=""

PORT=3100
