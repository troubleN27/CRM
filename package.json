{
  "name": "office-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "node --env-file=.env scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check:login": "node --env-file=.env scripts/check-login.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "sim:on": "tsx --env-file=.env scripts/simulator.ts on",
    "sim:off": "tsx --env-file=.env scripts/simulator.ts off",
    "sim:status": "tsx --env-file=.env scripts/simulator.ts status",
    "demo:today": "tsx --env-file=.env prisma/demo-today.ts",
    "mcp": "npm --prefix mcp-server start",
    "mcp:check": "npm --prefix mcp-server test",
    "design:check": "node scripts/design-check.mjs"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@gsap/react": "2.1.2",
    "@prisma/client": "6.19.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.15",
    "@visx/axis": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/pattern": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "bcryptjs": "3.0.3",
    "cmdk": "1.1.1",
    "exceljs": "4.4.0",
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "leaflet": "1.9.4",
    "lenis": "1.3.26",
    "motion": "12.43.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  }
}
