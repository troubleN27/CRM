# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env не попадает в Git.

POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://crm:CHANGE_ME@localhost:5433/office_crm"

# Секрет для входа (сгенерировать: npx auth secret)
AUTH_SECRET=""

# Пароли демо-пользователей (логины: admin, manager1, manager2, employee1 … employee10)
DEMO_ADMIN_PASSWORD=""
DEMO_MANAGER_PASSWORD=""
DEMO_EMPLOYEE_PASSWORD=""

# Ключ для ИИ-агента (только чтение /api/agent/*)
AGENT_API_KEY=""

# Часовой пояс офиса
OFFICE_TIMEZONE="America/Los_Angeles"

# Ключ устройств для POST /api/positions (имитация, датчики в офисе)
POSITIONS_API_KEY=""

# Центр города для прогулок в имитации: "широта,долгота" (по умолчанию Ташкент)
CITY_CENTER="41.3111,69.2797"

# Где офис на карте города: "широта,долгота" (демо — центр Ташкента)
OFFICE_LOCATION="41.3111,69.2797"
